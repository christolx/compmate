# Local development only. Keep credentials + both URLs in sync when changing.
POSTGRES_DB=compmate
POSTGRES_USER=compmate
POSTGRES_PASSWORD=compmate_dev
POSTGRES_PORT=55432
API_PORT=8080

# Compose API uses Docker's db hostname; native Go process uses localhost.
API_DATABASE_URL=postgres://compmate:compmate_dev@db:5432/compmate?sslmode=disable
DATABASE_URL=postgres://compmate:compmate_dev@127.0.0.1:55432/compmate?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
API_PROXY_TARGET=http://127.0.0.1:8080

# Native HTTP development uses nonsecure cookie; production override sets true.
# Original sample catalog imports once locally. Disable for empty DB.
SEED_DATA=true
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Production backend DNS hostname; required by compose.production.yaml.
# APP_HOST=api.your-campus.example
# Production PUBLIC_ORIGIN must be frontend Vercel HTTPS origin.
# PUBLIC_ORIGIN=https://compmate.vercel.app
